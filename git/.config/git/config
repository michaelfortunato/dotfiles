[alias]
  a = add
  b = branch
  c = commit
  # Default diff: file summary followed by the Delta-rendered patch.
  d = diff --stat --compact-summary --patch
  # Focused views for unstaged, staged, and all tracked local changes.
  dstat = diff --stat --compact-summary
  dfiles = diff --name-status
  dstaged = diff --cached --stat --compact-summary --patch
  dall = diff --stat --compact-summary --patch HEAD
  f = fetch
  g = grep
  l = log
  m = merge
  o = checkout
  p = pull
  s = status #FIXME: `gs` Conflicts with ghostscript
  sw = switch
  w = whatchanged
  # Difftastic-backed views:
  # - dlog: commit history. Add -p/--patch to see each commit's patch; this
  #   reads the worktree's HEAD/branch, not unstaged or staged file changes.
  dlog = -c diff.external=difft log --ext-diff
  # - dshow: one object/commit, HEAD by default, plus its patch.
  dshow = -c diff.external=difft show --ext-diff
  # - ddiff: structural view of unstaged changes, including a file summary.
  # - ddall: structural view of all tracked local changes.
  ddiff = -c diff.external=difft diff --stat --compact-summary --patch
  ddall = -c diff.external=difft diff --stat --compact-summary --patch HEAD
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[user]
	name = Michael Fortunato
	email = michael.n.fortunato@gmail.com
[include]
  # For the signing key, one per machine
  path = git-machine-specific-config
[core]
  pager = delta #pager = less -F -X
	editor = nvim
	commentChar = ";"
[init]
  templateDir = ~/.config/git/git-templates/default
	defaultBranch = main
[commit]
	gpgsign = true
  template = ~/.config/git/git-commit-template
[push]
  default = "current"
  autoSetupRemote = true
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  hyperlinks = true
  features = decorations
[delta "decorations"]
  file-decoration-style = blue ul
  hunk-header-decoration-style = blue box
  hunk-header-style = file line-number syntax
[diff]
  algorithm = histogram
  # colorMoved = zebra
  renames = true
[merge]
  tool = codediff
  conflictstyle = zdiff3 # could be cool
[mergetool]
  prompt = false
  keepBackup = false
[mergetool "codediff"]
  cmd = nvim \"$MERGED\" -c \"CodeDiff merge \\\"$MERGED\\\"\"
  trustExitCode = false
[mergetool "nvimdiff"]
  cmd = nvim -d \"$LOCAL\" \"$MERGED\" \"$REMOTE\"
[mergetool "opendiff"] # I don't mind the apple one, leave it as an optoin
  cmd = opendiff -merge \"$BASE\" \"$LOCAL\" \"$REMOTE\" -merge \"$MERGED\"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rebase]
	autoStash = true
[trace2]
	eventTarget = af_unix:stream:/Users/michaelfortunato/.git-ai/internal/daemon/trace2.sock
	eventNesting = 0
